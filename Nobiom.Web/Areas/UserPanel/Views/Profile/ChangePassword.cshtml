@using Nobiom.Domain.ViewModels.Account
@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغییر کلمه عبور";
}

<div class="auth-container">
    <div class="auth-title mb-3">تغییر رمز عبور</div>
    <!-- start of auth-box -->
    <div class="auth-box ui-box">
        <!-- start of auth-form -->
        <form asp-action="ChangePassword" class="auth-form">
            <!-- start of form-element -->
            <div class="form-element-row mb-3">
                <input asp-for="OldPassword" type="password" class="form-control" placeholder="رمز عبور فعلی">
            </div>
            <!-- end of form-element -->
            <!-- start of form-element -->
            <div class="form-element-row mb-3">
                <input asp-for="Password" type="password" class="form-control" placeholder="رمز عبور جدید">
            </div>
            <!-- end of form-element -->
            <!-- start of form-element -->
            <div class="form-element-row mb-3">
                <input asp-for="RePassword" type="password" class="form-control" placeholder="تکرار رمز عبور جدید">
            </div>
            <!-- end of form-element -->
            <!-- start of form-element -->
            <div class="form-element-row">
                <button class="btn btn-primary">تغییر رمز عبور</button>
            </div>
            <br>
            <div asp-validation-summary="All" class="text-danger"></div>
            <!-- end of form-element -->
        </form>
        <!-- end of auth-form -->
    </div>
    <!-- end of auth-box -->
</div>

