@using System.Security.Claims
@using Nobiom.Application.Extensions

<div class="ui-sticky ui-sticky-top">
    <div class="profile-user-info py-3 ui-box bg-white">
        <div class="profile-detail">
            <div class="d-flex align-items-center">
                <div class="profile-avatar me-3">
                    <img src="/Avatars/@(User.GetAvatar() ?? "default.png")"
                         alt="Avatar Preview"
                         class="rounded-circle border"
                         style="width: 50; height: 50; object-fit: cover;">
                </div>
                <div class="profile-info">
                    @{
                        var firstName = User.GetFirstName();
                        var displayName = !string.IsNullOrWhiteSpace(firstName) ? firstName : User.GetUserName() ?? "کاربر";

                        var hour = DateTime.Now.Hour;

                        var greeting = hour switch
                        {
                            >= 5 and < 12 => "صبح بخیر",
                            >= 12 and < 15 => "ظهر بخیر",
                            >= 15 and < 19 => "عصر بخیر",
                            >= 19 and < 23 => "شب بخیر",
                            _ => "شب خوش"
                        };
                    }

                    <a asp-area="UserPanel" asp-controller="Home" asp-action="Index"
                       class="text-decoration-none text-dark fw-bold mb-2">
                        @greeting، @displayName
                    </a>

                    <div class="text-muted fs-7 fw-bold">
                        @(User.GetMobile())
                    </div>
                </div>
            </div>
            <div class="user-options">
                <ul>
                    <li>
                        <span class="label">کیف پول</span>
                        <span class="detail">
                            <span class="d-block">۰ <span class="currency fs-7 fw-bold">تومان</span></span>
                            <a href="#" class="link border-bottom-0 text-info fs-7 fw-bold">
                                افزایش
                                موجودی <i class="ri-arrow-left-s-line"></i>
                            </a>
                        </span>
                    </li>
                </ul>
            </div>
        </div>
        <ul class="nav nav-items-with-icon flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="UserPanel" asp-controller="Profile" asp-action="ChangePassword">
                    <i class="nav-link-icon ri-lock-password-line"></i>
                    تغییر کلمه عبور
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="UserPanel" asp-controller="Profile" asp-action="Index">
                    <i class="nav-link-icon ri-user-2-line"></i>
                    ویرایش پروفایل
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="nav-link-icon ri-file-list-3-line"></i>
                    سفارش
                    های من
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="nav-link-icon ri-heart-3-line"></i> لیست
                    ها
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="nav-link-icon ri-chat-1-line"></i>
                    نظرات
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="nav-link-icon ri-map-pin-line"></i> نشانی
                    ها
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="nav-link-icon ri-gift-line"></i> کارت های
                    هدیه
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="nav-link-icon ri-notification-line"></i>
                    پیغام ها
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="nav-link-icon ri-time-line"></i> بازدید
                    های
                    اخیر
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="nav-link-icon ri-user-line"></i> اطلاعات
                    حساب
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Account" asp-action="Logout">
                    <i class="nav-link-icon ri-logout-box-r-line"></i>
                    خروج
                </a>
            </li>
        </ul>
    </div>
</div>