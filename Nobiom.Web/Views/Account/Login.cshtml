@using Nobiom.Domain.ViewModels.Account
@model LoginViewModel
@{
    ViewData["Title"] = "ورود به سایت";
}


<!-- start of auth-container -->
<div class="auth-container">
    <div class="auth-title mb-3">ورود به سایت</div>
    <!-- start of auth-box -->
    <div class="auth-box ui-box">
        <!-- start of auth-form -->
        <form asp-action="Login" class="auth-form">
            <!-- start of form-element -->
            <div class="form-element-row mb-2">
                <input asp-for="UserNameOrEmail" type="text" class="form-control" placeholder="نام کاربری یا ایمیل را وارد کنید">
            </div>
            <div class="form-element-row mb-2">
                <input asp-for="Password" type="password" class="form-control" placeholder="کلمه عبور را وارد کنید">
            </div>
            <!-- end of form-element -->
            <!-- start of form-element -->
            <div class="form-element-row mb-3">
                <button class="btn btn-primary">ورود</button>
            </div>
            <!-- end of form-element -->
            <!-- start of form-element -->
            <div class="form-element-row">
                <div class="mb-3">
                    <a href="#">کلمه عبورم را فراموش کردم</a>
                </div>
                <div class=" mb-3">
                    با ورود و یا ثبت نام در سایت شما <a href="#" class="link">
                    شرایط و
                    قوانین
                </a> استفاده
                از تمام سرویس های
                سایت و <a href="#" class="link">قوانین حریم خصوصی</a> آن را می‌پذیرید.
            </div>
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
        <!-- end of form-element -->
    </form>
    <!-- end of auth-form -->
</div>
</div>
<!-- end of auth-box -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}