@using Nobiom.Domain.ViewModels.Account
@model LoginViewModel
@{
    ViewData["Title"] = "ورود به سایت";
}

<!-- start of auth-container -->
<div class="auth-container">
    <div class="auth-title mb-3"> ورود به سایت </div>
    <!-- start of auth-box -->
    <div class="auth-box ui-box">
        <!-- start of auth-form -->
        <form asp-action="Login" class="auth-form">
            <!-- start of form-element -->
            <div class="form-element-row mb-1">
                <input asp-for="UserNameOrEmail" class="form-control" placeholder="نام کاربری یا ایمیل">
            </div>
            <div class="form-element-row mb-1">
                <input asp-for="Password" class="form-control" placeholder="کلمه عبور را وارد کنید">
            </div>
            <div class="row mb-1">
                <div class="col-1 pt-1">
                    <input asp-for="RememberMe" class="form-check" />
                </div>
                <div class="col-10">
                    <p>مرا به خاطر بسپار </p>
                </div>
            </div>
            @if (ViewBag.UserNotActivated != null)
            {
                <div class="form-element-row mb-2">
                    <span class="text-danger">حساب کاربری شما فعال نشده است. لطفا ایمیل خود را بررسی کنید.</span>
                </div>
            }
            <!-- end of form-element -->
            <!-- start of form-element -->
            <div class="form-element-row mb-3">
                <button class="btn btn-primary">ورود</button>
            </div>
            <!-- end of form-element -->
            <!-- start of form-element -->
            <div class="form-element-row">
                <div class="mb-3">
                    <a href="#">
                        کلمه عبورم را فراموش کرده ام .
                    </a>
                </div>
                <div class="mb-3">
                    با ورود و یا ثبت نام در سایت شما <a href="#" class="link">
                    شرایط و
                    قوانین
                </a> استفاده
                از تمام سرویس های
                سایت و <a href="#" class="link">قوانین حریم خصوصی</a> آن را می‌پذیرید.
            </div>
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
        <!-- end of form-element -->
    </form>
    <!-- end of auth-form -->
</div>
<!-- end of auth-box -->
</div>
<!-- start of auth-container -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
